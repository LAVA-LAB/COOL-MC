name: rl_model_checking
entry_points:
    main:
        parameters:
            # Meta
            project_name : {type: string, default: "Taxi with Fuel"}
            parent_run_id : {type: string, default: ""}
            prism_dir : {type: string, default: "../prism_files"}
            prism_file_path : {type: string, default: "transporter.prism"}
            constant_definitions : {type: string, default: ""}

            # Preprocessor
            preprocessor: {type: string, default: ""}

            # Interpreter
            interpreter: {type: string, default: ""}
            # Transition Updater
            transition_updater: {type: string, default: ""}
            idtmc_out: {type: string, default: ""}

            # Model Checking Parameters
            prop : {type: string, default: "Pmax=? [F jobs_done=2]"}

            # Quantum transformer agent
            n_qubits : {type: float, default: 4}
            poly_degree : {type: float, default: 2}
            remove_gates : {type: string, default: ""}


        command: >-
            python run.py --project_name={project_name} --parent_run_id={parent_run_id} --preprocessor={preprocessor} --prism_dir={prism_dir} --prism_file_path={prism_file_path} --constant_definitions={constant_definitions} --prop={prop} --interpreter={interpreter} --transition_updater={transition_updater} --idtmc_out={idtmc_out} --n_qubits={n_qubits} --poly_degree={poly_degree} --remove_gates={remove_gates}
